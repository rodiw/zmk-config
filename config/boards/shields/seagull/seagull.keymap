#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        Layer_1 {
            bindings = <&mo 1>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ===== MAIN HYPER MACRO LAYER =====
        default_layer {
            bindings = <
                &kp LC(LA(LG(U)))   &kp LC(LA(LG(I)))   &kp LC(LA(LG(D)))   &kp LC(LA(LG(F)))
                &kp LC(LA(LG(S)))   &kp LC(LA(LG(N)))   &kp LC(LA(LG(M)))   &kp LC(LA(LG(C)))
                &kp LC(LA(LG(V)))   &kp LC(LA(LG(W)))   &kp LC(LA(LG(E)))   &kp LC(LA(LG(P)))
                &kp LC(LA(LG(T)))   &kp LC(LA(LG(R)))   &kp LC(LA(LG(Y)))   &kp LC(LA(LG(B)))
            >;

            // Premium-feel encoder
            sensor-bindings = <
                &inc_dec_kp 4 C_VOL_DN C_VOL_UP
                &inc_dec_kp 3 PG_DN PG_UP
            >;
        };

        // ===== SETTINGS / BLUETOOTH LAYER =====
        Settings {
            bindings = <
                &trans        &trans        &trans       &trans
                &trans        &trans        &trans       &trans
                &trans        &trans        &bt BT_NXT   &bt BT_PRV
                &studio_unlock &trans       &trans       &trans
            >;

            sensor-bindings = <
                &inc_dec_kp 4 C_VOL_DN C_VOL_UP
            >;
        };
    };
};
